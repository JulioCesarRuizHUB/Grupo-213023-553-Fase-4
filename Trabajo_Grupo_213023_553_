class ErrorSoftwareFJ(Exception):
    """Error base controlado del sistema."""


class ErrorValidacion(ErrorSoftwareFJ):
    pass


class ErrorOperacion(ErrorSoftwareFJ):
    pass


class ErrorReserva(ErrorOperacion):
    pass


IMPUESTO_ASESORIA = Decimal("0")
DESCUENTO_ASESORIA = Decimal("10")
DURACION_ASESORIA = Decimal("1")


def _a_decimal(valor, campo):
    """Convierte a Decimal y rechaza valores inválidos o no finitos."""
    try:
        resultado = Decimal(str(valor))
    except (InvalidOperation, TypeError, ValueError) as error:
        raise ErrorValidacion(f"{campo} debe ser un valor numérico válido.") from error
    if not resultado.is_finite():
        raise ErrorValidacion(f"{campo} debe ser un valor numérico finito.")
    return resultado


class Entidad(ABC):
    def __init__(self, codigo):
        codigo = str(codigo).strip()
        if not codigo:
            raise ErrorValidacion("El código de la entidad es obligatorio.")
        self._codigo = codigo

    @property
    def codigo(self):
        return self._codigo

    @abstractmethod
    def describir(self):
        pass


class Cliente(Entidad):
    def __init__(self, identificacion, nombre, celular, correo, direccion):
        """Valida y encapsula los datos personales del cliente."""
        super().__init__(identificacion)
        campos = (nombre, celular, correo, direccion)
        if not all(str(campo).strip() for campo in campos):
            raise ErrorValidacion("Todos los datos personales del cliente son obligatorios.")
        if not re.fullmatch(r"[0-9]{5,15}(?:-[0-9]{1,2})?", str(identificacion).strip()):
            raise ErrorValidacion("La identificación debe tener entre 5 y 15 dígitos y un guion opcional.")
        if not re.fullmatch(r"[0-9]{7,15}", str(celular).strip()):
            raise ErrorValidacion("El celular debe contener entre 7 y 15 dígitos.")
        if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", str(correo).strip()):
            raise ErrorValidacion("El correo electrónico no tiene un formato válido.")
        self.__nombre = str(nombre).strip()
        self.__celular = str(celular).strip()
        self.__correo = str(correo).strip()
        self.__direccion = str(direccion).strip()

    @property
    def identificacion(self):
        return self.codigo

    @property
    def nombre(self):
        return self.__nombre

    @property
    def celular(self):
        return self.__celular

    @property
    def correo(self):
        return self.__correo

    @property
    def direccion(self):
        return self.__direccion

    def describir(self):
        return f"Cliente {self.nombre} ({self.identificacion})"


class Servicio(Entidad, ABC):
    def __init__(self, codigo, nombre, tarifa_hora):
        super().__init__(codigo)
        self._tarifa_hora = _a_decimal(tarifa_hora, "La tarifa")
        if self._tarifa_hora <= 0:
            raise ErrorValidacion("La tarifa del servicio debe ser mayor que cero.")
        self._nombre = str(nombre).strip()
        if not self._nombre:
            raise ErrorValidacion("El nombre del servicio es obligatorio.")

    @abstractmethod
    def validar_parametros(self, duracion):
        pass

    @abstractmethod
    def calcular_costo(
        self, duracion=1, impuesto=IMPUESTO_ASESORIA,
        descuento=DESCUENTO_ASESORIA
    ):
        pass

    @abstractmethod
    def describir(self):
        pass


class ServicioSalas(Servicio):
    def validar_parametros(self, duracion):
        horas = _a_decimal(duracion, "La duración")
        if horas <= 0 or horas > 2:
            raise ErrorValidacion("La reserva de sala debe durar entre 0 y 2 horas.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_parametros(duracion)
        return self._tarifa_hora * _a_decimal(duracion, "La duración")

    def describir(self):
        return f"Reserva de sala: {self._nombre}"


class ServicioEquipos(Servicio):
    def validar_parametros(self, duracion):
        if _a_decimal(duracion, "La duración") <= 0:
            raise ErrorValidacion("La duración del alquiler de equipos debe ser positiva.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_parametros(duracion)
        return self._tarifa_hora * _a_decimal(duracion, "La duración")

    def describir(self):
        return f"Alquiler de equipos: {self._nombre}"


class ServicioAsesoria(Servicio):
    IMPUESTO_PORCENTAJE = IMPUESTO_ASESORIA
    DESCUENTO_PORCENTAJE = DESCUENTO_ASESORIA

    def validar_parametros(self, duracion):
        horas = _a_decimal(duracion, "La duración")
        if horas <= 0 or horas > 24:
            raise ErrorValidacion("La asesoría debe durar más de 0 y hasta 24 horas.")

    def calcular_costo(
        self, duracion=1, impuesto=IMPUESTO_PORCENTAJE,
        descuento=DESCUENTO_PORCENTAJE
    ):
        """Calcula el total según las horas, el impuesto y el descuento indicados."""
        self.validar_parametros(duracion)
        horas = _a_decimal(duracion, "La duración")
        porcentaje_impuesto = _a_decimal(impuesto, "El impuesto")
        porcentaje_descuento = _a_decimal(descuento, "El descuento")
        if not 0 <= porcentaje_impuesto <= 100 or not 0 <= porcentaje_descuento <= 100:
            raise ErrorValidacion("Impuesto y descuento deben estar entre 0 y 100 por ciento.")
        subtotal = self._tarifa_hora * horas
        return (subtotal * (1 + porcentaje_impuesto / 100) *
                (1 - porcentaje_descuento / 100)).quantize(Decimal("1"))

    def describir(self):
        return f"Asesoría especializada: {self._nombre}"


class Reserva(Entidad):
    ESTADOS = ("pendiente", "confirmada", "procesada", "cancelada")

    def __init__(self, codigo, cliente, servicio, duracion):
        super().__init__(codigo)
        if not isinstance(cliente, Cliente) or not isinstance(servicio, Servicio):
            raise ErrorReserva("La reserva requiere un cliente y un servicio válidos.")
        try:
            self._duracion = _a_decimal(duracion, "La duración")
            servicio.validar_parametros(self._duracion)
        except (InvalidOperation, ErrorValidacion) as error:
            raise ErrorReserva("No se pudo validar la duración de la reserva.") from error
        self.cliente = cliente
        self.servicio = servicio
        self.estado = "pendiente"
        self.valor_asesoria = None

    def confirmar(self):
        """Cambia la reserva pendiente a confirmada."""
        if self.estado != "pendiente":
            raise ErrorReserva(f"No se puede confirmar una reserva en estado '{self.estado}'.")
        self.estado = "confirmada"

    def cancelar(self):
        """Cancela una reserva que todavía no ha sido procesada."""
        if self.estado in ("procesada", "cancelada"):
            raise ErrorReserva(f"No se puede cancelar una reserva en estado '{self.estado}'.")
        self.estado = "cancelada"

    def procesar(
        self, impuesto=IMPUESTO_ASESORIA, descuento=DESCUENTO_ASESORIA
    ):
        """Calcula y guarda el valor final de una reserva confirmada."""
        if self.estado != "confirmada":
            raise ErrorReserva("Solo se pueden procesar reservas confirmadas.")
        try:
            self.valor_asesoria = self.servicio.calcular_costo(self._duracion, impuesto, descuento)
        except ErrorSoftwareFJ as error:
            raise ErrorReserva("Falló el cálculo del costo de la reserva.") from error
        else:
            self.estado = "procesada"
            return self.valor_asesoria
        finally:
            logging.getLogger("software_fj").info("Procesamiento de reserva %s finalizado (estado: %s).", self.codigo, self.estado)

    @property
    def duracion(self):
        return self._duracion

    def describir(self):
        return f"Reserva {self.codigo}: {self.servicio.describir()} ({self.estado})"


def _crear_logger():
    """Configura el archivo local donde se registran eventos y errores."""
    logger = logging.getLogger("software_fj")
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        ruta_log = os.path.join(os.path.dirname(os.path.abspath(__file__)), "software_fj.log")
        manejador = logging.FileHandler(ruta_log, encoding="utf-8")
        manejador.setFormatter(logging.Formatter("%(asctime)s | %(levelname)s | %(message)s"))
        logger.addHandler(manejador)
    return logger


def _simular_operaciones(logger):
    """Ejecuta casos de dominio aislados y registra el resultado de cada operación."""
    realizadas = 0
    fallidas = 0

    def ejecutar(nombre, accion, debe_fallar=False):
        nonlocal realizadas, fallidas
        try:
            accion()
        except ErrorSoftwareFJ as error:
            realizadas += 1
            if debe_fallar:
                logger.warning("Simulación %02d: %s (fallo esperado: %s).",
                               realizadas, nombre, error)
            else:
                fallidas += 1
                logger.exception("Simulación %02d falló: %s.", realizadas, nombre)
        except Exception:
            realizadas += 1
            fallidas += 1
            logger.exception("Error inesperado en simulación: %s.", nombre)
        else:
            realizadas += 1
            if debe_fallar:
                fallidas += 1
                logger.error("La simulación debía fallar y fue exitosa: %s.", nombre)
            else:
                logger.info("Simulación %02d exitosa: %s.", realizadas, nombre)

    clientes = []

    def registrar_cliente(identificacion, nombre):
        if any(c.identificacion == identificacion for c in clientes):
            raise ErrorValidacion("La identificación ya está registrada.")
        cliente = Cliente(identificacion, nombre, "3001234567",
                          "cliente@example.com", "Calle 1")
        clientes.append(cliente)

    ejecutar("registro válido de cliente",
             lambda: registrar_cliente("900111222-1", "Cliente de prueba"))
    ejecutar("rechazo de cliente incompleto",
             lambda: Cliente("900111222-2", "", "3001234567",
                             "cliente@example.com", "Calle 2"), True)
    ejecutar("segundo registro válido de cliente",
             lambda: registrar_cliente("900111222-3", "Otro cliente"))
    ejecutar("rechazo de identificación duplicada",
             lambda: registrar_cliente("900111222-1", "Duplicado"), True)

    ejecutar("creación de servicio de salas",
             lambda: ServicioSalas("sala", "Sala de reuniones", 50000))
    ejecutar("creación de servicio de equipos",
             lambda: ServicioEquipos("equipo", "Alquiler de equipos", 25000))
    servicio = ServicioAsesoria("asesoria", "Asesoría técnica", 100000)
    ejecutar("creación de servicio de asesoría",
             lambda: servicio.validar_parametros(1))
    ejecutar("rechazo de tarifa no válida",
             lambda: ServicioAsesoria("invalido", "Servicio inválido", 0), True)
    reserva = Reserva("simulacion-1", clientes[0], servicio, 1)

    def procesar_reserva_valida():
        reserva.confirmar()
        reserva.procesar()

    ejecutar("confirmación y procesamiento de reserva exitosa",
             procesar_reserva_valida)
    ejecutar("rechazo de duración inválida",
             lambda: Reserva("simulacion-2", clientes[0], servicio, 0), True)

    reserva_cancelable = Reserva("simulacion-3", clientes[1], servicio, 1)
    ejecutar("cancelación de reserva pendiente", reserva_cancelable.cancelar)
    ejecutar("rechazo de procesamiento sin confirmación",
             lambda: Reserva("simulacion-4", clientes[1], servicio, 1).procesar(),
             True)

    logger.info("Simulación completa: %s operaciones, %s errores inesperados.",
                realizadas, fallidas)
    return realizadas, fallidas

