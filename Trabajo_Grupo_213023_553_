    # Validar y convertir los textos de fecha y horas a objetos datetime
    def _obtener_intervalo_reserva(self, fecha_texto, hora_inicio_texto, hora_fin_texto):
        try:
            fecha = datetime.strptime(fecha_texto, "%d/%m/%Y").date()
            hora_inicio = datetime.strptime(hora_inicio_texto, "%H:%M")
            hora_fin = datetime.strptime(hora_fin_texto, "%H:%M")
        except ValueError:
            return None

        if hora_inicio >= hora_fin:
            return None

        return fecha, hora_inicio, hora_fin

    # Verificar si una sala específica ya está reservada en un intervalo de tiempo dado
    def _sala_ocupada(self, sala, fecha, hora_inicio, hora_fin):
        for reserva in self.reservas_salas:
            if reserva.get("sala") != sala:
                continue
            if reserva.get("fecha") != fecha.strftime("%d/%m/%Y"):
                continue

            inicio_existente = datetime.strptime(reserva.get("hora_inicio"), "%H:%M")
            fin_existente = datetime.strptime(reserva.get("hora_fin"), "%H:%M")

            if (hora_inicio < fin_existente) and (hora_fin > inicio_existente):
                return True
        return False

    # Actualizar la lista de salas disponibles según la fecha y el horario ingresados
    def _actualizar_salas_disponibles(self, evento=None):
        fecha_texto = self.campos_sala['fecha'].get().strip()
        hora_inicio_texto = self.campos_sala['hora_inicio'].get().strip()
        hora_fin_texto = self.campos_sala['hora_fin'].get().strip()

        intervalo = self._obtener_intervalo_reserva(fecha_texto, hora_inicio_texto, hora_fin_texto)
        if intervalo is None:
            self.campos_sala['sala'].config(values=[f"Sala {i}" for i in range(1, 13)])
            return

        fecha, hora_inicio, hora_fin = intervalo
        salas_disponibles = [
            f"Sala {i}"
            for i in range(1, 13)
            if not self._sala_ocupada(f"Sala {i}", fecha, hora_inicio, hora_fin)
        ]

        self.campos_sala['sala'].config(values=salas_disponibles)
        sala_actual = self.campos_sala['sala'].get()
        if sala_actual and sala_actual not in salas_disponibles:
            self.campos_sala['sala'].set('')

    # Validar si la sala seleccionada está disponible en el horario actual ingresado
    def _validar_sala_seleccionada(self, evento=None):
        sala_seleccionada = self.campos_sala['sala'].get().strip()
        fecha_texto = self.campos_sala['fecha'].get().strip()
        hora_inicio_texto = self.campos_sala['hora_inicio'].get().strip()
        hora_fin_texto = self.campos_sala['hora_fin'].get().strip()

        intervalo = self._obtener_intervalo_reserva(fecha_texto, hora_inicio_texto, hora_fin_texto)
        if intervalo is None:
            return

        fecha, hora_inicio, hora_fin = intervalo
        if self._sala_ocupada(sala_seleccionada, fecha, hora_inicio, hora_fin):
            self._mostrar_advertencia("Sala ocupada", f"La {sala_seleccionada} ya está reservada en ese horario.")
            self.campos_sala['sala'].set('')

    # Guardar una nueva reserva de sala a partir de los datos ingresados en el formulario
    def guardar_reserva_sala(self):
        tipo = self.campos_sala['tipo'].get().strip()
        participante = self.campos_sala['participante'].get().strip()
        identificacion_empleado = self.campos_sala['identificacion_empleado'].get().strip()
        fecha_texto = self.campos_sala['fecha'].get().strip()
        hora_inicio_texto = self.campos_sala['hora_inicio'].get().strip()
        hora_fin_texto = self.campos_sala['hora_fin'].get().strip()
        sala = self.campos_sala['sala'].get().strip()

        # Validar campos vacíos según el tipo de participante
        if not tipo:
            self._mostrar_advertencia("Datos incompletos", "Selecciona el tipo de participante.")
            return

        if not participante:
            self._mostrar_advertencia("Datos incompletos", "Selecciona el participante de la reunión.")
            return

        if tipo == "Con Empleado" and not identificacion_empleado:
            self._mostrar_advertencia("Datos incompletos", "Ingresa la identificación del empleado.")
            return

        if not fecha_texto or not hora_inicio_texto or not hora_fin_texto or not sala:
            self._mostrar_advertencia("Datos incompletos", "Completa la fecha, el horario y la sala para guardar la reserva.")
            return

        try:
            fecha = datetime.strptime(fecha_texto, "%d/%m/%Y").date()
            hora_inicio = datetime.strptime(hora_inicio_texto, "%H:%M")
            hora_fin = datetime.strptime(hora_fin_texto, "%H:%M")
            hora_apertura = datetime.strptime("08:00", "%H:%M")
            hora_cierre = datetime.strptime("20:00", "%H:%M")
        except ValueError:
            self._mostrar_error("Formato inválido", "Usa el formato DD/MM/AAAA para la fecha y HH:MM para las horas.")
            return

        # Validar que la hora de inicio y fin estén dentro del horario permitido (de 08:00 a 20:00)
        if hora_inicio < hora_apertura or hora_fin > hora_cierre:
            self._mostrar_error("Horario inválido", "Las salas solo operan entre las 08:00 y las 20:00.")
            return

        # Validar que la hora de inicio sea menor a la hora de fin y que la duración no exceda 2 horas
        if hora_inicio >= hora_fin:
            self._mostrar_error("Error de tiempo", "La hora de finalización debe ser mayor a la hora de inicio.")
            return

        # Calcular la diferencia en horas entre la hora de inicio y la hora de fin
        diferencia_horas = (hora_fin - hora_inicio).total_seconds() / 3600
        if diferencia_horas > 2:
            self._mostrar_error("Límite excedido", "Las reuniones no pueden ser mayores a 2 horas.")
            return

        # Verificar si la sala está ocupada en el intervalo de tiempo especificado
        if self._sala_ocupada(sala, fecha, hora_inicio, hora_fin):
            self._mostrar_advertencia("Sala reservada", "La sala ya está reservada en ese horario.")
            return

        # Obtener la identificación del participante según el tipo de reunión
        if tipo == "Con Cliente":
            cliente = next((cliente for cliente in self.clientes if cliente['cliente'] == participante), None)
            if cliente is None:
                self._mostrar_error("Cliente no encontrado", "Selecciona un cliente registrado.")
                return
            identificacion = cliente['nit']
        else:
            if participante not in [empleado["nombre"] for empleado in self.empleados]:
                self._mostrar_error("Empleado no encontrado", "Selecciona un empleado válido.")
                return
            identificacion = identificacion_empleado

        # Generar un código único para la reserva de sala
        codigos_existentes = {reserva.get('codigo') for reserva in self.reservas_salas}
        numero_reserva = 1
        codigo = f"reserva-sala-{numero_reserva}"
        while codigo in codigos_existentes:
            numero_reserva += 1
            codigo = f"reserva-sala-{numero_reserva}"

        # Crear un diccionario con los datos de la reserva y agregarlo a la lista de reservas
        reserva = {
            "codigo": codigo, 
            "tipo": tipo, 
            "participante": participante, 
            "identificacion": identificacion, 
            "sala": sala, 
            "fecha": fecha.strftime("%d/%m/%Y"), 
            "hora_inicio": hora_inicio_texto, 
            "hora_fin": hora_fin_texto
        }

        self.reservas_salas.append(reserva)
        self.logger.info("Reserva de sala %s guardada para %s.", codigo, participante)
        self._actualizar_tabla_salas()
        
        # Limpiar los campos del formulario después de guardar la reserva
        for campo in self.campos_sala.values():
            campo.set('') if isinstance(campo, ttk.Combobox) else campo.delete(0, tk.END)
        self.etiqueta_participante_sala.grid_remove()
        self.etiqueta_identificacion_empleado.grid_remove()
        self.campos_sala['participante'].grid_remove()
        self.campos_sala['identificacion_empleado'].grid_remove()
        self.campos_sala['sala'].config(values=[f"Sala {i}" for i in range(1, 13)])

        messagebox.showinfo("Reserva Exitosa", f"Se guardó exitosamente con el código: {codigo}", parent=self.ventana)

    # Actualizar la tabla de reservas de salas con los datos almacenados
    def _actualizar_tabla_salas(self):
        for elemento in self.tabla_salas.get_children():
            self.tabla_salas.delete(elemento)
        for r in self.reservas_salas:
            self.tabla_salas.insert("", "end", values=(r['codigo'], r['tipo'], r['participante'], r['identificacion'], r['sala'], r['fecha'], r['hora_inicio'], r['hora_fin']))

