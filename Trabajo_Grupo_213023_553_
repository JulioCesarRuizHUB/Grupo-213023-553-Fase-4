    # Actualizar la tabla de clientes con los datos almacenados
    def _actualizar_tabla_clientes(self):
        for elemento in self.tabla_clientes.get_children():
            self.tabla_clientes.delete(elemento)
        for cliente in self.clientes:
            self.tabla_clientes.insert("", "end", values=tuple(cliente.values()))
        if hasattr(self, "campos_asesoria") and "cliente" in self.campos_asesoria:
            self.campos_asesoria["cliente"].config(values=[cliente["cliente"] for cliente in self.clientes])

    # Crear un nuevo cliente a partir de los datos ingresados en el formulario
    def crear_cliente(self):
        cliente = {clave: campo.get().strip() for clave, campo in self.campos_cliente.items()}

        if not all(cliente.values()):
            self._mostrar_advertencia("Datos incompletos", "Completa todos los campos para guardar el cliente.")
            return

        if any(registro["nit"] == cliente["nit"] for registro in self.clientes):
            self._mostrar_advertencia("Identificación duplicada", "Ya existe un cliente con ese NIT / C.C.")
            return

        try:
            cliente_objeto = Cliente(cliente["nit"], cliente["cliente"], cliente["celular"], cliente["correo"], cliente["direccion"])
        except ErrorValidacion as error:
            self._mostrar_error("Datos inválidos", str(error))
