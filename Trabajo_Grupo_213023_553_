    def _crear_pestana_clientes(self, pagina):

        # Configuración de la cuadrícula de la pestaña
        pagina.columnconfigure(0, weight=1)
        pagina.columnconfigure(1, weight=3)
        pagina.rowconfigure(0, weight=1)

        formulario = ttk.LabelFrame(pagina, text="Registrar cliente", padding=16, labelanchor="n")
        formulario.grid(row=0, column=0, sticky="nsew", padx=(0, 12))
        formulario.columnconfigure(0, weight=1)

        # Campos del formulario de clientes
        self.campos_cliente = {}
        campos = (("NIT / C.C.", "nit"), ("Cliente", "cliente"), ("Celular", "celular"), ("Correo", "correo"), ("Dirección", "direccion"))

        for fila, (etiqueta, clave) in enumerate(campos):
            ttk.Label(formulario, text=etiqueta).grid(row=fila * 2, column=0, sticky="w", pady=(8, 3))
            campo = ttk.Entry(formulario)
            campo.grid(row=fila * 2 + 1, column=0, sticky="ew")
            self.campos_cliente[clave] = campo

        ttk.Button(formulario, text="Guardar cliente", command=self.crear_cliente, style="Guardar.TButton").grid(row=len(campos) * 2, column=0, sticky="ew", pady=(18, 0))

        # Bloque de clientes almacenados
        bloque_clientes = ttk.LabelFrame(pagina, text="Clientes almacenados", padding=12, labelanchor="n")
        bloque_clientes.grid(row=0, column=1, sticky="nsew")
        bloque_clientes.columnconfigure(0, weight=1)
        bloque_clientes.rowconfigure(0, weight=1)

        # Tabla de clientes
        columnas = ("nit", "cliente", "celular", "correo", "direccion")
        self.tabla_clientes = ttk.Treeview(bloque_clientes, columns=columnas, show="headings")
        encabezados = {"nit": "NIT / C.C.", "cliente": "Cliente", "celular": "Celular", "correo": "Correo", "direccion": "Dirección"}
        anchos = {"nit": 120, "cliente": 180, "celular": 120, "correo": 200, "direccion": 200}

        for columna in columnas:
            self.tabla_clientes.heading(columna, text=encabezados[columna])
            self.tabla_clientes.column(columna, width=anchos[columna], minwidth=90, anchor="w")

        barra = ttk.Scrollbar(bloque_clientes, orient="vertical", command=self.tabla_clientes.yview)
        self.tabla_clientes.configure(yscrollcommand=barra.set)
        self.tabla_clientes.grid(row=0, column=0, sticky="nsew")
        barra.grid(row=0, column=1, sticky="ns")

        self._actualizar_tabla_clientes()

    # Actualizar la tabla de clientes con los datos almacenados
    def _actualizar_tabla_clientes(self):
        for elemento in self.tabla_clientes.get_children():
            self.tabla_clientes.delete(elemento)
        for cliente in self.clientes:
            self.tabla_clientes.insert("", "end", values=tuple(cliente.values()))

    # Crear un nuevo cliente a partir de los datos ingresados en el formulario
    def crear_cliente(self):
        cliente = {clave: campo.get().strip() for clave, campo in self.campos_cliente.items()}

        if not all(cliente.values()):
            messagebox.showwarning("Datos incompletos", "Completa todos los campos para guardar el cliente.", parent=self.ventana)
            return

        if any(registro["nit"] == cliente["nit"] for registro in self.clientes):
            messagebox.showwarning("Identificación duplicada", "Ya existe un cliente con ese NIT / C.C.", parent=self.ventana)
            return

        self.clientes.append(cliente)
        self._actualizar_tabla_clientes()

        for campo in self.campos_cliente.values():
            campo.delete(0, tk.END)

        messagebox.showinfo("Cliente guardado", f"Cliente {cliente['cliente']} registrado correctamente.", parent=self.ventana)

