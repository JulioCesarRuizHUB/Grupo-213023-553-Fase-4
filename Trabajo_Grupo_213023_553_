    # Guardar la asignación de equipos a una sala reservada
    def guardar_reserva_equipo(self):
        cod_sala = self.campos_equipo['cod_sala'].get().strip()
        combinacion = self.campos_equipo['equipos'].get().strip()

        if not cod_sala or not combinacion:
            messagebox.showwarning("Datos incompletos", "Selecciona sala y equipo.", parent=self.ventana)
            return

        eq_solicitados = []
        if combinacion == "TV":
            eq_solicitados = ["TV"]
        elif combinacion == "Video Beam":
            eq_solicitados = ["Video Beam"]
        elif combinacion == "Tablero":
            eq_solicitados = ["Tablero"]
        elif combinacion == "TV y Tablero":
            eq_solicitados = ["TV", "Tablero"]
        elif combinacion == "Video Beam y Tablero":
            eq_solicitados = ["Video Beam", "Tablero"]

        sala_ref = next((r for r in self.reservas_salas if r['codigo'] == cod_sala), None)
        if not sala_ref:
            messagebox.showerror("Error", "La sala seleccionada no existe.", parent=self.ventana)
            return

        try:
            f_req = sala_ref['fecha']
            h_ini_req = datetime.strptime(sala_ref['hora_inicio'], "%H:%M")
            h_fin_req = datetime.strptime(sala_ref['hora_fin'], "%H:%M")
        except ValueError:
            messagebox.showerror("Error", "Formato de hora incorrecto en la reserva de sala.", parent=self.ventana)
            return

        # Validar stock máximo de 12 unidades por equipo en horarios superpuestos
        for eq in eq_solicitados:
            ocupados = 0
            for r_eq in self.reservas_equipos:
                if r_eq['elemento'] == eq:
                    sala_pres = next((r for r in self.reservas_salas if r['codigo'] == r_eq['codigo_sala']), None)
                    if sala_pres and sala_pres['fecha'] == f_req:
                        he_ini = datetime.strptime(sala_pres['hora_inicio'], "%H:%M")
                        he_fin = datetime.strptime(sala_pres['hora_fin'], "%H:%M")
                        if (h_ini_req < he_fin) and (h_fin_req > he_ini):
                            ocupados += 1
            if ocupados >= 12:
                messagebox.showerror("Sin stock", f"No hay '{eq}' disponibles (Límite 12 superado).", parent=self.ventana)
                return

        for eq in eq_solicitados:
            self.reservas_equipos.append({"codigo_sala": cod_sala, "elemento": eq})

        self._actualizar_tabla_equipos()
        self.campos_equipo['cod_sala'].set('')
        self.campos_equipo['equipos'].set('')
        messagebox.showinfo("Éxito", f"Equipos asignados a {cod_sala}.", parent=self.ventana)

    # Actualizar la tabla de inventario reservado
    def _actualizar_tabla_equipos(self):
        for el in self.tabla_equipos.get_children():
            self.tabla_equipos.delete(el)
        for r in self.reservas_equipos:
            self.tabla_equipos.insert("", "end", values=(r['codigo_sala'], r['elemento']))

