    def _ajustar_ancho_info_asesoria(self, evento):
        """Adapta el ajuste de línea del mensaje al ancho del formulario."""
        self.etiqueta_info_asesoria.configure(wraplength=max(1, evento.width - 32))

    # Actualizar la lista de empleados disponibles según el tipo de asesoría seleccionado
    def _actualizar_empleados_asesoria(self, evento=None):
        tipo = self.campos_asesoria['tipo'].get()
        empleados_disponibles = [
            empleado['nombre'] for empleado in self.empleados if tipo in empleado['especialidades']
        ]
        self.campos_asesoria['empleado'].config(values=empleados_disponibles)
        self.campos_asesoria['empleado'].set('')

    # Actualizar la interfaz del módulo de asesorías según el lugar seleccionado
    def _actualizar_lugar_asesoria(self, evento=None):
        self._limpiar_reserva_asesoria()
        lugar = self.campos_asesoria['lugar'].get()

        # Si el lugar es "En sala de reunión", mostrar el botón para seleccionar reserva de sala y establecer los campos de fecha y hora como solo lectura
        if lugar == "En sala de reunión":
            self.boton_seleccionar_reserva_asesoria.grid()
            self.etiqueta_reserva_asesoria.grid()
            self.campos_asesoria['fecha'].config(state="readonly")
            self.campos_asesoria['hora_inicio'].config(state="readonly")
            self._mostrar_reservas_salas_asesoria()
        else:
            self.boton_seleccionar_reserva_asesoria.grid_remove()
            self.etiqueta_reserva_asesoria.grid_remove()
            self.campos_asesoria['fecha'].config(state="normal")
            self.campos_asesoria['hora_inicio'].config(state="normal")

    # Limpiar los campos y variables relacionados con la reserva de sala en el módulo de asesorías
    def _limpiar_reserva_asesoria(self):
        self.codigo_reserva_sala_asesoria = ""
        self.fecha_reserva_sala_asesoria = ""
        self.hora_inicio_reserva_sala_asesoria = ""
        self.etiqueta_reserva_asesoria.config(text="Sin reserva de sala seleccionada")
        self._establecer_campo_asesoria(self.campos_asesoria['fecha'], "")
        self._establecer_campo_asesoria(self.campos_asesoria['hora_inicio'], "")

    # Mostrar la ventana con las reservas de salas disponibles para asociar a una asesoría
    def _mostrar_reservas_salas_asesoria(self):
        if not self.reservas_salas:
            self._mostrar_advertencia("Sin reservas de sala", "No hay reservas de sala disponibles para seleccionar.")
            return

        ventana_reservas = tk.Toplevel(self.ventana)
        ventana_reservas.title("Seleccionar reserva de sala")
        ventana_reservas.geometry("820x420")
        ventana_reservas.transient(self.ventana)

        contenedor = ttk.Frame(ventana_reservas, padding=12)
        contenedor.pack(fill="both", expand=True)
        lienzo = tk.Canvas(contenedor, highlightthickness=0)
        barra = ttk.Scrollbar(contenedor, orient="vertical", command=lienzo.yview)
        lienzo.configure(yscrollcommand=barra.set)
        lienzo.pack(side="left", fill="both", expand=True)
        barra.pack(side="right", fill="y")

        filas = ttk.Frame(lienzo)
        ventana_filas = lienzo.create_window((0, 0), window=filas, anchor="nw")
        filas.bind("<Configure>", lambda evento: lienzo.configure(scrollregion=lienzo.bbox("all")))
        lienzo.bind("<Configure>", lambda evento: lienzo.itemconfigure(ventana_filas, width=evento.width))

        encabezados = ("", "Código de reserva", "Cliente / empleado", "Fecha", "Hora de inicio")
        for columna, encabezado in enumerate(encabezados):
            ttk.Label(filas, text=encabezado, font=("Arial", 10, "bold")).grid(
                row=0, column=columna, sticky="w", padx=6, pady=(0, 8)
            )

        for indice, reserva in enumerate(self.reservas_salas, start=1):
            fila = ttk.Frame(filas)
            fila.grid(row=indice, column=0, columnspan=len(encabezados), sticky="ew", pady=2)
            fila.columnconfigure(1, weight=1)

            ttk.Button(
                fila,
                text="Seleccionar",
                command=lambda registro=reserva, ventana=ventana_reservas: self._seleccionar_reserva_sala_asesoria(
                    registro, ventana
                )
            ).grid(row=0, column=0, sticky="w", padx=6, pady=4)
            valores = (
                reserva.get("codigo", ""),
                reserva.get("participante", reserva.get("cliente", "")),
                reserva.get("fecha", ""),
                reserva.get("hora_inicio", ""),
            )
            for columna, valor in enumerate(valores, start=1):
                ttk.Label(fila, text=valor).grid(row=0, column=columna, sticky="w", padx=6, pady=4)

        ventana_reservas.grab_set()

    # Asignar los datos de la reserva de sala seleccionada a los campos de la asesoría
    def _seleccionar_reserva_sala_asesoria(self, reserva, ventana_modal):
        self.codigo_reserva_sala_asesoria = reserva.get("codigo", "")
        self.fecha_reserva_sala_asesoria = reserva.get("fecha", "")
        self.hora_inicio_reserva_sala_asesoria = reserva.get("hora_inicio", "")

        self.etiqueta_reserva_asesoria.config(text=f"Reserva seleccionada: {self.codigo_reserva_sala_asesoria}")
        self._establecer_campo_asesoria(self.campos_asesoria['fecha'], self.fecha_reserva_sala_asesoria)
        self._establecer_campo_asesoria(self.campos_asesoria['hora_inicio'], self.hora_inicio_reserva_sala_asesoria)

        ventana_modal.destroy()

    def _configurar_marca_agua(self, campo, texto):
        """Añade una marca de agua que se quita al enfocar el campo."""
        campo.marca_agua = texto
        campo.insert(0, texto)
        campo.configure(foreground="#808080")
        campo.bind("<FocusIn>", lambda evento: self._quitar_marca_agua(evento.widget))
        campo.bind("<FocusOut>", lambda evento: self._restaurar_marca_agua(evento.widget))

    def _quitar_marca_agua(self, campo):
        """Retira el texto de ayuda antes de que el usuario escriba."""
        if campo.cget("state") == "readonly":
            return
        if campo.get() == campo.marca_agua:
            campo.delete(0, tk.END)
            campo.configure(foreground="black")

    def _restaurar_marca_agua(self, campo):
        """Restaura la marca de agua si el campo queda vacío."""
        if campo.cget("state") == "readonly":
            return
        if not campo.get().strip():
            campo.insert(0, campo.marca_agua)
            campo.configure(foreground="#808080")

    # Establecer el valor de un campo de texto que puede estar en modo de solo lectura
    def _establecer_campo_asesoria(self, campo, valor):
        estado_original = campo.cget("state")
        campo.config(state="normal")
        campo.delete(0, tk.END)
        if valor:
            campo.insert(0, valor)
            campo.configure(foreground="black")
        else:
            campo.insert(0, campo.marca_agua)
            campo.configure(foreground="#808080")
        campo.config(state=estado_original)

    # Guardar una nueva asesoría a partir de los datos ingresados en el formulario
    def guardar_asesoria(self):
        """Valida los datos, calcula una hora de asesoría y guarda la reserva."""
        tipo = self.campos_asesoria['tipo'].get().strip()
        nombre_cliente = self.campos_asesoria['cliente'].get().strip()
        empleado = self.campos_asesoria['empleado'].get().strip()
        lugar = self.campos_asesoria['lugar'].get().strip()
        fecha_texto = self.campos_asesoria['fecha'].get().strip()
        hora_inicio = self.campos_asesoria['hora_inicio'].get().strip()

        if not all((tipo, nombre_cliente, empleado, lugar)):
            self._mostrar_advertencia("Datos incompletos", "Completa el tipo de asesoría, el cliente, el empleado y el lugar.")
            return

        cliente = next((r for r in self.clientes_objetos if r.nombre == nombre_cliente), None)
        if cliente is None:
            self._mostrar_error("Cliente no disponible", "Selecciona un cliente registrado.")
            return

        empleado_valido = any(r['nombre'] == empleado and tipo in r['especialidades'] for r in self.empleados)
        if not empleado_valido:
            self._mostrar_error("Empleado no disponible", "Selecciona un empleado con la especialidad requerida.")
            return

        if lugar == "En sala de reunión":
            if not self.codigo_reserva_sala_asesoria:
                self._mostrar_advertencia("Reserva requerida", "Selecciona una reserva de sala para la asesoría.")
                return
            reserva_sala = next((r for r in self.reservas_salas if r.get("codigo") == self.codigo_reserva_sala_asesoria), None)
            if reserva_sala is None:
                self._mostrar_error("Reserva no disponible", "La reserva de sala seleccionada ya no está disponible.")
                return
            if (reserva_sala.get("tipo") == "Con Cliente" and
                    reserva_sala.get("identificacion") != cliente.identificacion):
                self._mostrar_error("Cliente no coincide", "Selecciona el mismo cliente asociado a la reserva de sala.")
                return
            fecha_asesoria = self.fecha_reserva_sala_asesoria
            hora_asesoria = self.hora_inicio_reserva_sala_asesoria
            codigo_reserva = self.codigo_reserva_sala_asesoria
        elif lugar == "Lugar designado por cliente":
            try:
                fecha_asesoria = datetime.strptime(fecha_texto, "%d/%m/%Y").strftime("%d/%m/%Y")
                datetime.strptime(hora_inicio, "%H:%M")
            except ValueError:
                self._mostrar_error("Fecha u hora inválida", "Ingresa la fecha en formato DD/MM/AAAA y la hora en formato HH:MM.")
                return
            hora_asesoria = hora_inicio
            codigo_reserva = ""
        else:
            self._mostrar_error("Lugar inválido", "Selecciona un lugar de reunión válido.")
            return

        try:
            duracion = DURACION_ASESORIA
            impuesto = ServicioAsesoria.IMPUESTO_PORCENTAJE
            descuento = ServicioAsesoria.DESCUENTO_PORCENTAJE
            servicio = ServicioAsesoria(tipo, tipo, Decimal("100000"))
        except (InvalidOperation, ErrorSoftwareFJ) as error:
            self._mostrar_error("Costo inválido", "La duración debe ser un número válido.")
            self._registrar_error("No se pudieron validar los parámetros del costo.", error)
            return

        codigos_existentes = {asesoria["codigo"] for asesoria in self.asesorias}
        numero = 1
        codigo_asesoria = f"asesoria-{numero}"
        while codigo_asesoria in codigos_existentes:
            numero += 1
            codigo_asesoria = f"asesoria-{numero}"

        try:
            reserva_objeto = Reserva(codigo_asesoria, cliente, servicio, duracion)
            reserva_objeto.confirmar()
            costo = reserva_objeto.procesar(impuesto, descuento)
        except ErrorSoftwareFJ as error:
            self._mostrar_error("No se pudo procesar la asesoría", str(error))
            self._registrar_error("Error controlado al crear la reserva de asesoría.", error)
            return

        asesoria = {
            "codigo": codigo_asesoria,
            "tipo": tipo,
            "cliente": cliente.nombre,
            "empleado": empleado,
            "lugar": lugar,
            "codigo_reserva_sala": codigo_reserva,
            "fecha_reserva_sala": self.fecha_reserva_sala_asesoria if codigo_reserva else "",
            "hora_inicio_reserva_sala": self.hora_inicio_reserva_sala_asesoria if codigo_reserva else "",
            "fecha": fecha_asesoria,
            "hora_inicio": hora_asesoria,
            "duracion": str(duracion),
            "valor_asesoria": str(reserva_objeto.valor_asesoria),
        }
        self.asesorias.append(asesoria)
        self.reservas_asesoria.append(reserva_objeto)
        self._actualizar_tabla_asesorias()
        self.logger.info("Asesoría %s guardada para %s. Total: %s COP; estado: %s.", codigo_asesoria, cliente.nombre, costo, reserva_objeto.estado)
        valor_final = f"{costo:,.0f}".replace(",", ".")

        self.campos_asesoria['tipo'].set("")
        self.campos_asesoria['cliente'].set("")
        self.campos_asesoria['empleado'].set("")
        self.campos_asesoria['empleado'].config(values=[])
        self.campos_asesoria['lugar'].set("")
        self._limpiar_reserva_asesoria()
        self.campos_asesoria['fecha'].config(state="normal")
        self.campos_asesoria['hora_inicio'].config(state="normal")
        self.boton_seleccionar_reserva_asesoria.grid_remove()
        self.etiqueta_reserva_asesoria.grid_remove()
        messagebox.showinfo(
            "Asesoría guardada",
            f"La asesoría se guardó con el código {codigo_asesoria}.\n"
            f"Valor final: {valor_final} COP (sin IVA y con descuento del 10%).",
            parent=self.ventana
        )

    # Actualizar la tabla de asesorías con los datos almacenados
    def _actualizar_tabla_asesorias(self):
        for elemento in self.tabla_asesorias.get_children():
            self.tabla_asesorias.delete(elemento)
        for asesoria in self.asesorias:
            columnas = ("codigo", "tipo", "empleado", "lugar", "codigo_reserva_sala", "fecha", "hora_inicio", "duracion")
            valores = [asesoria[campo] for campo in columnas]
            valores.append(f"{Decimal(asesoria['valor_asesoria']):,.0f}".replace(",", ".") + " COP")
            self.tabla_asesorias.insert("", "end", values=valores)

    # Iniciar el ciclo principal de eventos de Tkinter
    def ejecutar(self):
        self.ventana.mainloop()

